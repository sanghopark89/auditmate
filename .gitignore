# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 삭제 대기 파일 (사용자가 직접 확인 후 삭제)
/trash-can/

# typescript
*.tsbuildinfo
next-env.d.ts

# 점검 내용을 담은 실제 형식 샘플·작업 기록은 올리지 않는다
/data/
/.bkit/
/.claude/

# 업무망 반입용 폴더(빌드 결과)
/offline-package/
